r close, uniqueness is organization+project stable id+action; business_complete and financial_archive distinct.","Any failure rolls back facts, consumption, audit, outbox and idempotency success; ledgers unchanged.","dry_run: no durable effects or event ids."]},"synthetic_cases":[{"id":"service_confirmation_approve","target":"service_confirmation","given":{"creator":"demo-maker","reviewer":"demo-finance","decision":"approve","workflow":"submitted","period":"open","contract":"approved","evidence":"same_project","source_stable_id":"demo-001"},"expect":{"accept":true,"entity_status":"confirmed","ledger_delta":0,"cost_delta":0,"ar_delta":0,"ap_delta":0,"cash_delta":0,"revenue_delta":0}},{"id":"spend_commitment_approve","target":"spend_commitment","given":{"creator":"demo-maker","reviewer":"demo-finance","decision":"approve","workflow":"submitted","period":"open","contract":"approved","evidence":"same_project","source_stable_id":"demo-001"},"expect":{"accept":true,"entity_status":"approved","ledger_delta":0,"cost_delta":0,"ar_delta":0,"ap_delta":0,"cash_delta":0,"revenue_delta":0}},{"id":"complete_with_retention","target":"project_close","given":{"action":"business_complete","delivery":"accepted","warranty_ar_cents":50000,"etc_cents":10000,"unapproved_count":1,"unresolved_count":0},"expect":{"accept":true,"phase":"business_complete","ar_delta":0,"revenue_delta":0,"cash_delta":0,"archive_certified":false}},{"id":"archive_retention_followup","target":"project_close","given":{"action":"financial_archive","business_complete":true,"etc_cents":0,"unapproved_count":0,"unresolved_count":0,"warranty_ar_cents":50000,"retention":"contract_valid_not_due_with_followup","warranty_obligations":"resolved"},"expect":{"accept":true,"phase":"financial_archive","ar_delta":0,"ledger_delta":0}},{"id":"close_retry","target":"project_close","given":{"mutation":"same_key_same_normalized_input","base_case":"archive_retention_followup"},"expect":{"result_type":"existing","additional_events":0,"all