{
  "$schema": "./contract-bundle.schema.json",
  "global_rules": {
    "currency": "CNY",
    "transaction": "authorize+period+source+business+ledger+bridge+audit+outbox atomically",
    "locks": "organization, period, project, sources, cash_transaction, open_item, allocation sorted by stable id",
    "history": "append/reverse/forward-adjust only; never update posted ledger or snapshot",
    "rounding": "Decimal ROUND_HALF_UP; strict reversal preserves original cents"
  },
  "contract_catalog": [
    {
      "id": "C01",
      "owner": "core authorization",
      "consumers": [
        "all commands",
        "all queries"
      ],
      "objects": [
        "CommandContext",
        "MembershipScope",
        "SensitiveReadAudit",
        "AgentGrant",
        "Membership"
      ],
      "bridges": [
        "member-project-scope"
      ],
      "commands": [
        "identity.membership.change/v1",
        "identity.agent_grant.revoke/v1",
        "core.document.decide/v1"
      ],
      "queries": [
        "identity.context.get/v1",
        "identity.permissions.get/v1"
      ],
      "events": [
        "identity.membership_changed.v1",
        "identity.agent_grant_revoked.v1"
      ],
      "consumed_bridges": [
        "membership-employee-binding"
      ]
    },
    {
      "id": "C02",
      "owner": "core ledger/audit/outbox",
      "consumers": [
        "all financial domains",
        "imports",
        "legacy adapters"
      ],
      "objects": [
        "SourceRef",
        "AccountingEvent",
        "LedgerPosting",
        "AuditRecord",
        "OutboxEvent",
        "IdempotencyRecord",
        "SourceConsumption"
      ],
      "bridges": [
        "event-reversal",
        "source-event"
      ],
      "commands": [
        "core.posting.append/v1",
        "core.posting.reverse/v1"
      ],
      "queries": [
        "core.source.trace/v1",
        "core.event.get/v1"
      ],
      "events": [
        "core.accounting_posted.v1",
        "core.posting_reversed.v1"
      ]
    },
    {
      "id": "C03",
      "owner": "masterdata + contracts counterparty",
      "consumers": [
        "contracts",
        "delivery",
        "time",
        "costing",
        "settlement",
        "cash",
        "invoicing"
      ],
      "objects": [
