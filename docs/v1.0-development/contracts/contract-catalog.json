      ],
      "commands": [
        "costing.cost.post/v1",
        "costing.allocation.run/v1",
        "costing.allocation.reverse/v1",
        "costing.salary_pool.draft.save/v1",
        "costing.expense_claim.draft.save/v1",
        "costing.spend_commitment.draft.save/v1",
        "costing.spend_acceptance.draft.save/v1",
        "costing.prepaid_service.draft.save/v1"
      ],
      "queries": [
        "costing.source.available/v1",
        "costing.reconciliation.get/v1"
      ],
      "events": [
        "costing.cost_posted.v1",
        "costing.allocated.v1"
      ],
      "consumed_bridges": [
