        "settlement.clearance.create/v1",
        "settlement.clearance.reverse/v1",
        "settlement.offset.create/v1",
        "settlement.settlement.draft.save/v1",
        "settlement.credit_adjustment.draft.save/v1",
        "settlement.bad_debt_disposition.draft.save/v1"
      ],
