      ],
      "commands": [
        "onboarding.opening.commit/v1",
        "period.close/v1",
        "period.adjustment.post/v1",
        "onboarding.opening_batch.draft.save/v1"
      ],
      "queries": [
        "period.precheck.get/v1",
        "onboarding.coverage.get/v1"
      ],
