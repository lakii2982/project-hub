        "period.closed.v1",
        "onboarding.opening_committed.v1"
      ]
    },
    {
      "id": "C12",
      "owner": "insights / delivery evidence",
      "consumers": [
        "pages",
        "exports",
        "authorized API",
        "release verification"
      ],
      "objects": [
        "MetricDefinition",
        "ReadModelWatermark",
        "DataGap",
        "Evidence",
        "TraceLink",
        "ExportManifest",
        "DeliveryReceipt",
        "ReconciliationCase",
        "IntegrityFinding",
        "BackupManifest",
        "DeploymentManifest",
        "ReleaseManifest",
        "RestoreEvidence",
        "ConcurrencyTestEvidence"
      ],
      "bridges": [
        "metric-source-trace",
        "evidence-entity"
      ],
      "commands": [
        "insights.export.create/v1",
        "delivery.evidence.attach/v1"
      ],
      "queries": [
        "insights.metric.get/v1",
        "insights.workspace.get/v1",
        "insights.data_gaps.get/v1"
      ],
      "events": [
        "insights.export_ready.v1",
        "delivery.evidence_attached.v1"
      ]
    }
  ],
  "definitions": {
    "entities": [
      {
        "name": "CommandContext",
        "owner": "identity",
        "schema_ref": "./entities.schema.json#/$defs/CommandContext"
      },
      {
        "name": "AgentGrant",
        "owner": "identity",
        "schema_ref": "./entities.schema.json#/$defs/AgentGrant"
      },
      {
        "name": "AccountingEvent",
        "owner": "core",
        "schema_ref": "./entities.schema.json#/$defs/AccountingEvent"
      },
      {
        "name": "Counterparty",
        "owner": "contracts",
        "schema_ref": "./entities.schema.json#/$defs/Counterparty"
      },
      {
        "name": "ContractLine",
        "owner": "contracts",
        "schema_ref": "./entities.schema.json#/$defs/ContractLine"
      },
      {
        "name": "Acceptance",
        "owner": "delivery",
        "schema_ref": "./entities.schema.json#/$defs/Acceptance"
      },
      {
        "name": "Timesheet",
        "owner": "time",
        "schema_ref": "./entities.schema.json#/$defs/Timesheet"
      },
      {
        "name": "CostEvent",
        "owner": "costing",
        "schema_ref": "./entities.schema.json#/$defs/CostEvent"
      },
      {
        "name": "OpenItem",
        "owner": "settlement",
        "schema_ref": "./entities.schema.json#/$defs/OpenItem"
      },
      {
        "name": "CashTransaction",
        "owner": "cash",
        "schema_ref": "./entities.schema.json#/$defs/CashTransaction"
      },
      {
        "name": "Invoice",
        "owner": "invoicing",
        "schema_ref": "./entities.schema.json#/$defs/Invoice"
      },
      {
        "name": "RevenueRecognition",
        "owner": "management_revenue",
        "schema_ref": "./entities.schema.json#/$defs/RevenueRecognition"
      },
      {
        "name": "BudgetVersion",
        "owner": "planning",
        "schema_ref": "./entities.schema.json#/$defs/BudgetVersion"
      },
      {
        "name": "ETCItem",
        "owner": "planning",
        "schema_ref": "./entities.schema.json#/$defs/ETCItem"
      },
      {
        "name": "OpeningBatch",
        "owner": "onboarding",
        "schema_ref": "./entities.schema.json#/$defs/OpeningBatch"
      },
      {
        "name": "MetricDefinition",
        "owner": "insights",
        "schema_ref": "./entities.schema.json#/$defs/MetricDefinition"
      }
    ],
    "bridges": [
      {
        "name": "TimesheetBillableConfirmation",
        "owner": "time",
        "left": {
          "namespace": "time",
          "object_types": [
            "Timesheet"
          ]
        },
        "right": {
          "namespace": "contracts",
          "object_types": [
            "ContractLine"
          ]
        },
        "amount_or_quantity": "confirmed_minutes",
        "unique_key": "timesheet source coverage+contract line",
        "reversal": "append reversal; preserve original approved minutes",
        "x-contract-limits": [
          "sum confirmed minutes <= approved timesheet minutes",
          "cost minutes remain independent"
        ]
      },
      {
        "name": "CostAllocation",
        "owner": "costing",
        "left": {
          "namespace": "costing",
          "object_types": [
            "CostEvent"
          ]
        },
        "right": {
          "namespace": "masterdata",
          "object_types": [
            "Project",
            "NonProjectDestination"
          ]
        },
        "amount_or_quantity": "allocated_cents",
        "unique_key": "allocation run+source+target",
        "reversal": "reverse whole run before reallocation",
        "x-contract-limits": [
          "sum active allocation <= available source cents",
          "largest remainder stable order",
          "source not additionally counted in company totals"
        ]
      },
      {
        "name": "Clearance",
        "owner": "settlement",
        "left": {
          "namespace": "cash",
          "object_types": [
            "CashTransaction"
          ]
        },
        "right": {
          "namespace": "settlement",
          "object_types": [
            "OpenItem"
          ]
        },
        "amount_or_quantity": "cleared_cents",
        "unique_key": "cash transaction+open item+request/source key",
        "reversal": "one reversal record restores both available balances",
        "x-contract-limits": [
          "same organization/counterparty/CNY",
          "amount <= both derived available balances",
          "cross-project requires explicit approved exception",
          "no bank transaction created"
        ]
      },
      {
        "name": "AdvanceOffset",
        "owner": "settlement",
        "left": {
          "namespace": "cash",
          "object_types": [
            "AdvanceBalance"
          ]
        },
        "right": {
          "namespace": "settlement",
          "object_types": [
            "OpenItem"
          ]
        },
        "amount_or_quantity": "offset_cents",
        "unique_key": "advance+open item+source key",
        "reversal": "append reversal restores both balances",
        "x-contract-limits": [
          "no cash/income/cost event",
          "partial offsets supported"
        ]
      },
      {
        "name": "CashAllocation",
        "owner": "cash",
        "left": {
          "namespace": "cash",
          "object_types": [
            "CashTransaction"
          ]
        },
        "right": {
          "namespace": "masterdata",
          "object_types": [
            "Project",
            "NonProjectDestination"
          ]
        },
        "amount_or_quantity": "allocated_cents",
        "unique_key": "transaction+target+source key",
        "reversal": "append reversal",
        "x-contract-limits": [
          "sum allocations <= transaction amount",
          "not a clearance or second cash fact"
        ]
      },
      {
        "name": "InvoiceAllocation",
        "owner": "invoicing",
        "left": {
          "namespace": "invoicing",
          "object_types": [
            "Invoice"
          ]
        },
        "right": {
          "namespace": "costing",
          "object_types": [
            "CostEvent",
            "OpenItem"
          ]
        },
        "amount_or_quantity": "gross/net/tax cents",
        "unique_key": "invoice+business source+line",
        "reversal": "red invoice linked to original; no deletion",
        "x-contract-limits": [
          "each gross/net/tax sum <= independent source remainder",
          "does not create duplicate cost/revenue/open item"
        ]
      },
      {
        "name": "PerformanceSettlementMatch",
        "owner": "management_revenue",
        "left": {
          "namespace": "management_revenue",
          "object_types": [
            "RevenueRecognition"
          ]
        },
        "right": {
          "namespace": "settlement",
          "object_types": [
            "Settlement"
          ]
        },
        "amount_or_quantity": "matched_net_cents",
        "unique_key": "contract line+performance coverage+settlement coverage",
        "reversal": "unmatch then rebuild correct allocation",
        "x-contract-limits": [
          "match only same contract line",
          "no duplicate revenue",
          "unsettled performance and settled-unperformed stay mutually exclusive"
        ]
      },
      {
        "name": "ForecastCoverage",
        "owner": "cash forecast",
        "left": {
          "namespace": "cash",
          "object_types": [
            "ForecastSource"
          ]
        },
        "right": {
          "namespace": "cash",
          "object_types": [
            "CashTransaction",
            "OpenItem"
          ]
        },
        "amount_or_quantity": "replaced_cents",
        "unique_key": "source coverage range+replacement",
        "reversal": "append release/correction",
        "x-contract-limits": [
          "partial replacement retains remainder",
          "same coverage exists at only one prediction layer"
        ]
      },
      {
        "name": "OpeningCoverage",
        "owner": "onboarding/domains",
        "left": {
          "namespace": "onboarding",
          "object_types": [
            "OpeningBatch"
          ]
        },
        "right": {
          "namespace": "onboarding",
          "object_types": [
            "OpeningCoverage"
          ]
        },
        "amount_or_quantity": "period/category/project coverage",
        "unique_key": "organization+project/pool+period+category",
        "reversal": "opening correction only via domain adjustment",
        "x-contract-limits": [
          "detail rebuild and balance carry are mutually exclusive for same coverage",
          "historical reference rows never re-post"
        ]
      }
    ],
    "invariants": [
      "Every formal financial record has organization, project/pool, SourceRef, evidence/approval chain, business date and posting period.",
      "Balances are derived from effective append-only events and bridges; UI/API has no balance update command.",
      "All write paths acquire locks in global C11 order and either commit all facts/audit/outbox or none.",
      "Formal approval is version-bound and rejects self-review; an edited version invalidates approval.",
      "Unknown policies, evidence, rates, taxes, or coverage yield explicit gaps/pending state, never fabricated zero.",
      "Algorithms and rate snapshots are historical facts; a new policy applies prospectively or by explicit forward adjustment."
    ]
  }
}
