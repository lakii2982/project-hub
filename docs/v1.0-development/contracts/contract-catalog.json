        "RateSnapshot",
        "CostPolicy",
        "ExpenseClaim",
        "SpendCommitment",
        "SpendAcceptance",
        "PrepaidService",
        "CostEvent",
        "AllocationRun",
        "AllocationTarget",
        "TaxQualification"
      ],
      "bridges": [
