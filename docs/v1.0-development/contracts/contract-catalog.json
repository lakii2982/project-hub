        "Contact",
        "CostCategory",
        "NonProjectDestination",
        "MergeMap",
        "EmployeeBinding"
      ],
      "bridges": [
        "counterparty-role",
        "masterdata-merge",
        "membership-employee-binding"
      ],
      "commands": [
        "masterdata.entity.upsert/v1",
        "masterdata.entity.merge/v1"
      ],
      "queries": [
        "masterdata.entity.get/v1",
        "masterdata.lookup.search/v1"
      ],
      "events": [
        "masterdata.entity_changed.v1"
      ]
    },
    {
      "id": "C04",
      "owner": "contracts",
      "consumers": [
        "delivery",
        "settlement",
        "management_revenue",
        "planning"
      ],
      "objects": [
        "Contract",
        "ContractVersion",
        "ContractLine",
        "PaymentTerm",
        "WarrantyTerm",
        "MethodPolicySelection",
        "ContractChange"
      ],
      "bridges": [
        "contract-line-policy",
        "contract-line-payment-term"
      ],
      "commands": [
