      ]
    },
    {
      "id": "C08",
      "owner": "cash",
      "consumers": [
        "settlement",
        "reconciliation",
        "forecast"
      ],
      "objects": [
        "FundingAccount",
        "CashTransaction",
        "CashClassification",
        "CashAllocation",
        "AdvanceBalance",
        "Refund",
        "BankReturn",
        "InternalTransfer",
        "CashForecastItem",
        "EmployeeAdvance"
      ],
      "bridges": [
        "cash-transaction-allocation",
        "forecast-source-coverage"
      ],
      "commands": [
        "cash.transaction.record/v1",
        "cash.allocation.create/v1",
        "cash.refund.record/v1",
        "cash.return.record/v1",
        "cash.funding_account.draft.save/v1"
      ],
      "queries": [
        "cash.transaction.get/v1",
        "cash.account_coverage.get/v1"
      ],
      "events": [
        "cash.transaction_recorded.v1",
        "cash.refunded.v1",
        "cash.returned.v1"
      ],
      "consumed_bridges": [
        "cash-openitem-clearance"
      ]
    },
    {
      "id": "C09",
      "owner": "invoicing / management_revenue",
      "consumers": [
        "reconciliation",
        "insights"
      ],
      "objects": [
        "Invoice",
        "InvoiceLine",
        "InvoiceAllocation",
        "InvoiceReversal",
        "RevenueRecognition",
        "RevenueAdjustment",
        "PerformanceSettlementMatch"
      ],
      "bridges": [
        "invoice-business-allocation",
        "performance-settlement-match"
      ],
      "commands": [
        "invoicing.invoice.record/v1",
        "invoicing.invoice.reverse/v1",
        "management_revenue.recognize/v1",
        "management_revenue.match/v1"
      ],
      "queries": [
        "invoicing.unallocated.get/v1",
        "management_revenue.contract_line.get/v1"
      ],
      "events": [
        "invoicing.recorded.v1",
        "management_revenue.recognized.v1",
        "management_revenue.matched.v1"
      ]
    },
    {
      "id": "C10",
      "owner": "costing/planning and cash forecast",
      "consumers": [
        "insights",
        "exports"
      ],
      "objects": [
        "BudgetVersion",
        "BudgetLine",
        "ETCVersion",
        "ETCItem",
        "Scenario",
        "ForecastSource",
        "ForecastCoverage",
        "EstimateRelease"
      ],
      "bridges": [
        "etc-actual-release"
      ],
      "commands": [
        "planning.budget.approve/v1",
        "planning.etc.publish/v1",
        "cash.forecast.replace/v1",
        "planning.budget_version.draft.save/v1",
        "planning.budget_line.draft.save/v1",
        "planning.e_t_c_version.draft.save/v1",
        "planning.e_t_c_item.draft.save/v1"
      ],
      "queries": [
        "planning.eac.get/v1",
        "cash.forecast.13week/v1"
      ],
      "events": [
        "planning.budget_approved.v1",
        "planning.etc_published.v1",
        "cash.forecast_replaced.v1"
      ],
      "consumed_bridges": [
        "forecast-source-coverage"
      ]
    },
    {
      "id": "C11",
      "owner": "core periods + domain opening commands",
      "consumers": [
        "all write services",
        "onboarding",
        "close"
      ],
      "objects": [
        "AccountingPeriod",
        "PeriodClose",
        "OpeningBatch",
        "OpeningCoverage",
        "OpeningEvent",
        "AdjustmentRequest",
        "ImportPreview",
        "ImportConflict",
        "OnboardingSession",
        "PeriodPrecheck"
      ],
      "bridges": [
        "opening-coverage-history",
        "period-event-snapshot"
      ],
      "commands": [
        "onboarding.opening.commit/v1",
        "period.close/v1",
        "period.adjustment.post/v1",
        "onboarding.opening_batch.draft.save/v1"
      ],
      "queries": [
        "period.precheck.get/v1",
        "onboarding.coverage.get/v1"
      ],
      "events": [
