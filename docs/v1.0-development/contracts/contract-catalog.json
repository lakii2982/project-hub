      ]
    },
    {
      "id": "C11",
      "owner": "core periods + domain opening commands",
      "consumers": [
        "all write services",
        "onboarding",
        "close"
      ],
      "objects": [
        "AccountingPeriod",
        "PeriodClose",
        "OpeningBatch",
        "OpeningCoverage",
        "OpeningEvent",
        "AdjustmentRequest",
        "ImportPreview",
