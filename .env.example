# 复制到.env后填写；.env只供docker compose读取，勿提交到源码库。
PMO_DOMAIN=pmo.example.com
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-at-least-40-characters
POSTGRES_PASSWORD=replace-with-a-separate-random-database-password
# 可选。未开启时工时/财务/规则预警均可使用。
PMO_AI_ENABLED=0
PMO_AI_BASE_URL=
PMO_AI_MODEL=deepseek-v4.1-flash
PMO_AI_API_KEY=
